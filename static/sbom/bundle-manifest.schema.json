{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://help.revealbi.io/sbom/bundle-manifest.schema.json",
  "title": "Reveal SBOM bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bundle", "format", "files"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "product", "packageVersion", "platform", "platformLabel", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "product": {"enum": ["Reveal Server", "Reveal AI"]},
        "packageVersion": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"},
        "platform": {"enum": ["dotnet", "java", "node"]},
        "platformLabel": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "mediaType"],
      "properties": {
        "name": {"const": "CycloneDX"},
        "version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
        "mediaType": {"const": "application/vnd.cyclonedx+json"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file"}
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "kind", "archivePath", "mediaType", "sha256"],
      "properties": {
        "displayName": {"type": "string", "minLength": 1},
        "kind": {"enum": ["aggregate", "base", "connector", "package", "runtime"]},
        "archivePath": {"type": "string", "pattern": "^(?![/\\\\]|.*\\.\\.).+\\.cdx\\.json$"},
        "mediaType": {"const": "application/vnd.cyclonedx+json"},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "packageName": {"type": "string", "minLength": 1},
        "architecture": {"enum": ["win-x64", "linux-x64"]},
        "architectureLabel": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "runtime"}}, "required": ["kind"]},
          "then": {"required": ["architecture", "architectureLabel"]}
        },
        {
          "if": {"properties": {"kind": {"enum": ["connector", "package"]}}, "required": ["kind"]},
          "then": {"required": ["packageName"]}
        }
      ]
    }
  }
}
